# =============================================================================
# StartAI - variáveis de ambiente (arquivo ÚNICO para backend e frontend)
#
# Jeito rápido: na raiz do projeto rode
#     python scripts/configurar_env.py
# Ele cria o .env a partir deste arquivo e já gera a JWT_SECRET_KEY.
#
# Jeito manual: copie este arquivo para ".env" (na raiz) e preencha.
#
# O .env NUNCA vai para o GitHub (está no .gitignore). No deploy, as mesmas
# variáveis são cadastradas no painel do Render (backend) e da Vercel
# (frontend) - ver a seção "Deploy" do README.
# =============================================================================

# --- Banco de dados (backend) ------------------------------------------------
# Troque SUA_SENHA pela senha do seu PostgreSQL local.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/entrevistaia

# --- Segurança / login (backend) ---------------------------------------------
# Gerada automaticamente pelo scripts/configurar_env.py.
# Manual: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Inteligência Artificial (backend) ---------------------------------------
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Vagas de emprego (backend) ---------------------------------------------
# Chave gratuita da Jooble (500 chamadas no total, sem cartão), pedida em
# https://br.jooble.org/api/about (a chave é do Brasil; cada país tem a sua).
# Sem ela, o resto do sistema funciona; só a página Vagas avisa que falta.
JOOBLE_API_KEY=
# Só mude se a Jooble indicar outro endereço junto com a chave.
JOOBLE_API_URL=https://br.jooble.org/api/

# --- E-mail de recuperação de senha (backend, opcional em dev) ---------------
# Com Gmail, use uma "senha de app" (não a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Endereços (backend) -----------------------------------------------------
# Usado no link do e-mail de recuperação de senha.
FRONTEND_URL=http://localhost:5173
# Sites que podem chamar a API (separados por vírgula). Em produção, inclua
# a URL da Vercel, ex.: https://startai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---------------------------------------------------------
# Só variáveis com prefixo VITE_ chegam ao navegador. Nunca coloque segredo aqui.
VITE_API_URL=http://localhost:8000
